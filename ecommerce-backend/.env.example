# Backend environment variables
# Copy to .env and set values. Never commit .env to version control.

# MongoDB connection string
MONGO_URL=mongodb://localhost:27017/ecommerce

# Server
PORT=5000
NODE_ENV=development

# Frontend URL (for CORS). In production use your frontend origin, e.g. https://your-app.vercel.app
FRONTEND_URL=http://localhost:5173

# Frontend base URL (where users browse the app). Used for payment redirects and links.
BASE_URL=http://localhost:5173

# Backend public URL. Required in production for Stripe success redirect.
# Example: https://api.yourdomain.com
BACKEND_URL=http://localhost:5000

# JWT secret (use a long random string in production)
JWT_SECRET=your-super-secret-jwt-key-change-in-production

# Stripe (get keys from https://dashboard.stripe.com/apikeys)
STRIPE_SECRET_KEY=sk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...
